generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDIENTE
  ACTIVO
  BLOQUEADO
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  role          UserRole  @default(USER)
  // Fase 0: las cuentas nuevas nacen PENDIENTE (lo fija lib/auth.ts) hasta que
  // un ADMIN las aprueba. El default de BD es ACTIVO para que los usuarios que
  // ya existían no pierdan el acceso al aplicar el cambio.
  status        UserStatus @default(ACTIVO)
  sessions      Session[]
  accounts      Account[]

  // ✅ NUEVO: viajes creados por este admin
  createdTrips    Trip[]           @relation("AdminTrips")
  // ✅ NUEVO: asignaciones de viajes
  tripAssignments TripAssignment[]

  // 🆕 Flujo de aprobación: viajes que este usuario ha solicitado / aprobado
  requestedTrips Trip[] @relation("RequestedTrips")
  approvedTrips  Trip[] @relation("ApprovedTrips")

  // 🆕 Partes de gastos de oficina de este usuario
  officeExpenses OfficeExpense[]
  reimbursements Reimbursement[]

  @@map("user")
}

enum TripStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Flujo de estados (se reutiliza TripStatus, no se añaden valores):
//   PENDIENTE → solicitud sin aprobar. El USER puede editarla pero NO cargar gastos.
//   APROBADO  → el USER ya puede cargar gastos.
//   RECHAZADO → denegada, bloqueada.
// Un viaje creado directamente por un ADMIN nace en APROBADO: no hay a quién pedírselo.
model Trip {
  id        String     @id @default(cuid())

  // Quién creó el viaje siendo admin. 🆕 null cuando lo solicitó un USER.
  createdByAdminId String?
  createdByAdmin   User?  @relation("AdminTrips", fields: [createdByAdminId], references: [id])

  // 🆕 USER que solicitó el viaje (null si lo creó un admin directamente).
  // Es lo que distingue el origen de un viaje en el Excel de resumen.
  requestedById String?
  requestedBy   User?   @relation("RequestedTrips", fields: [requestedById], references: [id])

  // 🆕 Sello de aprobación. Se rellena al pasar a APROBADO y se limpia al salir.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("ApprovedTrips", fields: [approvedById], references: [id])

  city      String
  startDate DateTime
  endDate   DateTime
  project   String?
  notes     String?
  status    TripStatus @default(PENDIENTE)
  totalAmount Decimal  @default(0)
  numberInvoice String?

  // Fase 1: itinerario. Los tramos son la fuente de verdad; `city`, `startDate`
  // y `endDate` de arriba se recalculan a partir de ellos (lib/trip-stages.ts)
  // para que los listados y los Excel existentes sigan funcionando igual.
  stages        TripStage[]
  // Comunidad autónoma del viaje (todas sus ciudades son de la misma).
  region        String?

  // ✅ NUEVO: usuarios asignados (many-to-many)
  assignedUsers TripAssignment[]
  expenses      Expense[]
  // 🆕 Billetes y reservas del viaje (Cloudinary, fuera de la migración a SharePoint)
  documents     TripDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trips")
  @@index([createdByAdminId])
  @@index([requestedById])
  @@index([status])
}

// 🆕 Tipos de documento que el admin puede adjuntar a un viaje.
enum TripDocumentType {
  BILLETE
  RESERVA
  OTRO
}

// 🆕 Documentos del viaje (billete de avión/tren, reserva de hotel).
// Se guardan en Cloudinary bajo el prefijo `trip-documents/`, FUERA de `tickets/`,
// que es el único que recorre la migración a SharePoint. No se migran: son la
// única copia, así que tampoco debe barrerlos la limpieza de Cloudinary.
model TripDocument {
  id     String           @id @default(cuid())
  tripId String
  trip   Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type   TripDocumentType

  url      String
  publicId String // public_id de Cloudinary: necesario para poder borrar el fichero
  fileName String
  mimeType String
  size     Int

  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("trip_documents")
  @@index([tripId])
  @@index([tripId, type])
}

// ✅ NUEVO: tabla intermedia
// Fase 1: catálogo de ciudades (lo mantiene el ADMIN). `isOther` marca la
// entrada "Otro (especificar)", que exige texto libre en el tramo.
model City {
  id        String      @id @default(cuid())
  name      String      @unique
  region    String?
  isOther   Boolean     @default(false)
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  stages    TripStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cities")
}

// Fase 1: tramo (destino) de un viaje. Un viaje simple tiene un tramo.
model TripStage {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position      Int      // 1, 2, 3… en orden de itinerario
  cityId        String
  city          City     @relation(fields: [cityId], references: [id])
  // Texto libre cuando la ciudad es "Otro (especificar)"
  cityOther     String?
  arrivalDate   DateTime
  departureDate DateTime
  expenses      Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([cityId])
  @@map("trip_stages")
}

model TripAssignment {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@map("trip_assignments")
  @@index([tripId])
  @@index([userId])
}

// 🆕 Parte de gastos de oficina: el equivalente al Trip para gastos que NO son de
// viaje. No pasa por aprobación — el USER lo crea y carga gastos directamente.
// Sus categorías van a cuentas contables distintas (scope "office" en
// lib/expense-categories.ts).
enum OfficeExpenseStatus {
  ABIERTO
  CERRADO
}

model OfficeExpense {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year  Int
  month Int
  title String?
  notes String?

  status      OfficeExpenseStatus @default(ABIERTO)
  totalAmount Decimal             @default(0)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un único parte por usuario y mes: cierra la puerta a duplicados
  @@unique([userId, year, month])
  @@map("office_expenses")
  @@index([userId])
}

// Un Expense pertenece a un Trip O a un OfficeExpense, nunca a los dos ni a
// ninguno. Prisma no puede expresar ese "exactamente uno": lo garantizan las
// rutas, donde cada endpoint escribe solo su columna.
model Expense {
  id            String   @id @default(cuid())
  tripId        String?
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // 🆕 Alternativa a tripId: gasto de oficina
  officeExpenseId String?
  officeExpense   OfficeExpense? @relation(fields: [officeExpenseId], references: [id], onDelete: Cascade)

  date          DateTime
  amount        Decimal
  category      String?  // Taxi, Comida, Hotel, Metrobus/Parking, Gasolina, Billete ← NUEVO
  vendor        String?
  description   String?
  receiptUrl    String?
  invoiceNumber String?
  paymentMethod String?

  // Fase 2: quién registró el gasto (a quién se reembolsa un adelanto personal).
  // null en gastos anteriores a la Fase 2.
  createdById        String?
  // Fase 2: proyecto o empresa a la que se acudió (obligatorio en oficina)
  justification      String?
  // Fase 2: kilometraje. km de ida × 2 = km computables; importe = km × tarifa.
  // La tarifa se guarda en cada gasto: un cambio futuro no altera los antiguos.
  originOffice       String?
  destinationAddress String?
  kmOneWay           Decimal?
  kmTotal            Decimal?
  ratePerKm          Decimal?

  // Fase 1: tramo del viaje al que se imputa el gasto (null en gastos de oficina)
  stageId       String?
  stage         TripStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  
  // ✅ NUEVO: gastos creados por admin (billete) son visibles pero editables por user
  createdByAdminId String? // null = creado por user, filled = creado por admin
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
  @@index([tripId])
  @@index([officeExpenseId])
  @@index([stageId])
}

// El resto (Session, Account, Verification) sin cambios...
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
  @@index([identifier])
}
// Fase 2: tarifa de kilometraje (€/km) con fecha de vigencia. Se aplica la
// última cuya `validFrom` sea <= fecha del gasto.
model MileageRate {
  id          String   @id @default(cuid())
  ratePerKm   Decimal
  validFrom   DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([validFrom])
  @@map("mileage_rates")
}

// Fase 2: transferencia de fin de mes a un empleado por sus adelantos
// personales. Guarda el importe pagado para detectar gastos añadidos después.
model Reimbursement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  amount    Decimal
  paidAt    DateTime @default(now())
  paidById  String?
  note      String?

  @@unique([userId, year, month])
  @@map("reimbursements")
}
